+  { id: "trip.new", title: "New trip", shortcut: "mod+n", run: () => {} },
+  { id: "place.pin", title: "Pin place", shortcut: "mod+p", run: () => {} },
+  { id: "view.help", title: "Show help", shortcut: "?", run: () => {} },
 ];
 
+/** Resolves a keydown to a command, ignoring keys typed into fields. */
+export function commandForKey(event: KeyboardEvent): Command | undefined {
+  const target = event.target as HTMLElement | null;
+  if (target?.closest("input, textarea, [contenteditable]")) return undefined;
+  const mod = event.metaKey || event.ctrlKey ? "mod+" : "";
+  const key = `${mod}${event.key.toLowerCase()}`;
+  return commands.find((command) => command.shortcut === key);
+}
